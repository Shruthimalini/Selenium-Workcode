<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Amazon Automation Suite" parallel="tests" thread-count="2">
<listeners>
    <listener class-name="amazonautomate.Listeners"/>
</listeners>

  <test name="Negative Test - Error Validation">
    <classes>
      <class name="amazonautomate.AmazonErrorTest"/>
    </classes>
  </test>

  <test name="Positive Test - Valid Login and Purchase">
    <classes>
      <class name="amazonautomate.AmazonTest"/>
    </classes>
  </test>

</suite>
